<Window x:Class="Songliste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SongList" Height="680" Width="920" MinHeight="480" MinWidth="640"
        Background="{StaticResource BgPrimary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Placeholder adorner style for search box -->
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Padding" Value="40,10,12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>   <!-- header -->
            <RowDefinition Height="44"/>   <!-- column headers -->
            <RowDefinition Height="*"/>    <!-- list -->
            <RowDefinition Height="80"/>   <!-- footer / FAB area -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             HEADER
             ═══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgHeader}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Music icon -->
                <Viewbox Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                          Fill="#1DB954" Stretch="Uniform"/>
                </Viewbox>

                <!-- App title -->
                <TextBlock Grid.Column="1" Text="SongList"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Song count badge -->
                <Border Grid.Column="2" Background="#1A2A1A" CornerRadius="12"
                        Padding="10,4" Height="26"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                    <TextBlock x:Name="songCountBadge"
                               Foreground="#1DB954"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <!-- Search box -->
                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <TextBox x:Name="searchBox"
                             Style="{StaticResource SearchBox}"
                             TextChanged="SearchBox_TextChanged"/>
                    <!-- Search icon overlay -->
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left"
                             Margin="12,0,0,0" IsHitTestVisible="False">
                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="#535353" Stretch="Uniform"/>
                    </Viewbox>
                    <!-- Placeholder -->
                    <TextBlock x:Name="searchPlaceholder" Text="Suchen..."
                               Foreground="#535353" FontSize="13"
                               Margin="40,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             COLUMN HEADERS (Spotify style)
             ═══════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource BgPrimary}">
            <Border.BorderBrush><SolidColorBrush Color="#2A2A2A"/></Border.BorderBrush>
            <Border.BorderThickness><Thickness Bottom="1"/></Border.BorderThickness>
            <Grid Margin="24,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#"
                           Foreground="#535353" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="TITEL"
                           Foreground="#535353" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="ARTIST"
                           Foreground="#535353" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="JAHR"
                           Foreground="#535353" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             SONG LIST
             ═══════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="songsList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="rowBorder"
                                Margin="0" Padding="0"
                                BorderThickness="0,0,0,1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#1A1A1A"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush x:Name="rowBg" Color="Transparent"/>
                            </Border.Background>

                            <Grid x:Name="rowGrid" Height="56" Margin="24,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- Index number -->
                                <TextBlock x:Name="indexText" Grid.Column="0"
                                           Text="{Binding Index}"
                                           Foreground="#535353" FontSize="13"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <!-- Music note icon -->
                                <Viewbox Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center">
                                    <Path x:Name="noteIcon"
                                          Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                          Stretch="Uniform">
                                        <Path.Fill>
                                            <SolidColorBrush x:Name="noteFill" Color="#535353"/>
                                        </Path.Fill>
                                    </Path>
                                </Viewbox>

                                <!-- Title -->
                                <TextBlock Grid.Column="2" Text="{Binding Song.title}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="12,0,16,0"/>

                                <!-- Artist -->
                                <TextBlock Grid.Column="3" Text="{Binding Song.artist}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Year -->
                                <TextBlock Grid.Column="4" Text="{Binding Song.year}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" VerticalAlignment="Center"/>

                                <!-- Delete button (shown on hover) -->
                                <Button Grid.Column="5" x:Name="deleteBtn"
                                        Style="{StaticResource DeleteButton}"
                                        Opacity="0"
                                        Tag="{Binding Song}"
                                        Click="DeleteSong_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Hover triggers -->
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="rowBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#1E1E1E" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="noteFill"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#1DB954" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="deleteBtn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="rowBg"
                                                            Storyboard.TargetProperty="Color"
                                                            To="Transparent" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="noteFill"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#535353" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="deleteBtn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>

                        <!-- Item entrance animation on Loaded -->
                        <DataTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="rowBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.3"
                                                         EasingFunction="{x:Null}"/>
                                        <ThicknessAnimation Storyboard.TargetName="rowBorder"
                                                            Storyboard.TargetProperty="Margin"
                                                            From="-20,0,20,0" To="0,0,0,0"
                                                            Duration="0:0:0.25">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty-state message -->
        <StackPanel x:Name="emptyState" Grid.Row="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <Viewbox Width="64" Height="64" Margin="0,0,0,16" Opacity="0.2">
                <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                      Fill="White" Stretch="Uniform"/>
            </Viewbox>
            <TextBlock Text="Keine Songs gefunden" Foreground="#535353"
                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Füge deinen ersten Song hinzu" Foreground="#3A3A3A"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════
             FOOTER / FAB
             ═══════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BgPrimary}">
            <Border.BorderBrush><SolidColorBrush Color="#1E1E1E"/></Border.BorderBrush>
            <Border.BorderThickness><Thickness Top="1"/></Border.BorderThickness>
            <Grid Margin="24,0">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12">
                    <Run Text="songs.json · "/>
                    <Run x:Name="pathRun" Text="" Foreground="#3A3A3A"/>
                </TextBlock>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Click="AddSong_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                  Fill="Black" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Song hinzufügen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
