<Window x:Class="Songliste.AddSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Song hinzufügen"
        Width="420" Height="480"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid>
        <!-- Semi-transparent backdrop -->
        <Border Background="#80000000" x:Name="backdrop" Opacity="0"/>

        <!-- Card -->
        <Border x:Name="card"
                Background="#1E1E1E"
                CornerRadius="16"
                Margin="32"
                Padding="32,28"
                RenderTransformOrigin="0.5,1.0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="cardSlide" Y="40"/>
            </Border.RenderTransform>
            <Border.Opacity>0</Border.Opacity>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                  Fill="#1DB954" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Song hinzufügen"
                                   Foreground="White"
                                   FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="32" Height="32"
                            Click="Close_Click"
                            Cursor="Hand" BorderThickness="0" Background="Transparent"
                            ToolTip="Schließen">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBorder" CornerRadius="6" Width="32" Height="32">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="closeBg" Color="Transparent"/>
                                    </Border.Background>
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                              Stretch="Uniform">
                                            <Path.Fill>
                                                <SolidColorBrush x:Name="closeColor" Color="#535353"/>
                                            </Path.Fill>
                                        </Path>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="closeColor"
                                                                Storyboard.TargetProperty="Color"
                                                                To="#FFFFFF" Duration="0:0:0.1"/>
                                                <ColorAnimation Storyboard.TargetName="closeBg"
                                                                Storyboard.TargetProperty="Color"
                                                                To="#2A2A2A" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="closeColor"
                                                                Storyboard.TargetProperty="Color"
                                                                To="#535353" Duration="0:0:0.1"/>
                                                <ColorAnimation Storyboard.TargetName="closeBg"
                                                                Storyboard.TargetProperty="Color"
                                                                To="Transparent" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Titel label + input -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="TITEL" Foreground="#535353" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtTitle" Style="{StaticResource DarkTextBox}"
                             KeyDown="Input_KeyDown"/>
                </StackPanel>

                <!-- Artist label + input -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="ARTIST" Foreground="#535353" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtArtist" Style="{StaticResource DarkTextBox}"
                             KeyDown="Input_KeyDown"/>
                </StackPanel>

                <!-- Jahr label + input -->
                <StackPanel Grid.Row="6">
                    <TextBlock Text="JAHR" Foreground="#535353" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtYear" Style="{StaticResource DarkTextBox}"
                             KeyDown="Input_KeyDown"/>
                </StackPanel>

                <!-- Error message -->
                <Border Grid.Row="8" x:Name="errorBorder"
                        Background="#2A1515" CornerRadius="8" Padding="12,8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="errorText"
                               Foreground="#ED4245" FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Add button -->
                <Button Grid.Row="10"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Padding="0,14"
                        Click="AddSong_Click">
                    <TextBlock Text="Song hinzufügen" FontSize="15"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
